<svg xmlns="http://www.w3.org/2000/svg" width="800" height="450" viewBox="0 0 800 450">
  <defs>
    <linearGradient id="g1" x1="0" x2="1">
      <stop offset="0%" stop-color="#2563eb"/>
      <stop offset="100%" stop-color="#ef4444"/>
    </linearGradient>
    <style>
      .title { font: 700 48px 'Poppins', sans-serif; fill: #fff; }
      .sub { font: 400 20px 'Poppins', sans-serif; fill: rgba(255,255,255,0.9); }
    </style>
  </defs>
  <rect width="100%" height="100%" fill="url(#g1)" rx="8" ry="8" />
  <g transform="translate(40,60)">
    <text class="title">Company</text>
    <text class="sub" y="56">Sample Logo</text>
  </g>
</svg>
